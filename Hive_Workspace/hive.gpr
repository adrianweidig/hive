with "gtkada";

project Hive is

   type Build_Kind is
      ("static", "static-pic", "relocatable");
   for Source_Dirs use ("src/**","test/**");
   for Object_Dir use "obj";
   LIBRARY_TYPE : Build_Kind := "static";

   case LIBRARY_TYPE is

      when "static" =>
         for Main use ("mainhive.adb","testmanager.adb");

      when "static-pic" =>

      when "relocatable" =>

   end case;

   package Documentation is

      case LIBRARY_TYPE is

         when "static" =>
            for Documentation_Dir use "../Dokumente/GnatDoc";
            for Image_Dir use "Data/Images";

         when "static-pic" =>

         when "relocatable" =>

      end case;
   end Documentation;

end Hive;

